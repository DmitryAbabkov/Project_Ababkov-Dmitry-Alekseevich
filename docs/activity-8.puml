@startuml activity-8
title Администрирование системы

|Администратор системы|
start
:Открыть панель\nадминистрирования;
:Выбрать раздел;

if (Управление\nпользователями?) then (да)
    :Выбрать действие\n(создать/заблокировать/удалить);
    if (Удаление пользователя?) then (да)
        :Проверить активные\nсессии и данные;
    else (нет)
    endif
    :Назначить роль\nпользователю;
    :Сохранить изменения;
else if (Управление\nсправочниками?) then (да)
    :Выбрать справочник\n(факультеты/кафедры/\nспециальности и др.);
    :Выбрать действие\n(добавить/изменить/удалить);
    if (Удаление записи справочника?) then (да)
        if (Запись используется\nв планах/поручениях?) then (да)
            :Запретить удаление;\nВывести сообщение;
            stop
        else (нет)
        endif
    else (нет)
    endif
    :Сохранить изменения\nв справочнике;
else (нет)
    :Открыть журнал событий;
    :Просмотреть историю\nдействий пользователей;
endif

:Записать действие\nв журнал событий;

stop
@enduml