@startuml activity-6
title Управление данными преподавателей

|Заведующий кафедрой|
start
:Открыть раздел\n"Преподаватели";
:Выбрать действие;

if (Добавить преподавателя?) then (да)
    :Ввести ФИО, категорию,\nкафедру;
else (нет)
    :Выбрать существующего\nпреподавателя;
    :Выбрать данные для изменения;
endif

if (Изменяется должность\nдоцента/профессора?) then (да)
    if (Есть учёное звание?) then (нет)
        :Вывести сообщение\nоб ограничении;
        stop
    else (да)
    endif
endif

if (Категория — ассистент\nили преподаватель?) then (да)
    :Отметить участие\nв аспирантуре (опционально);
endif

if (Категория — ст. преподаватель\nили доцент?) then (да)
    :Указать научные темы\n(опционально);
endif

if (Категория — профессор?) then (да)
    :Указать научные направления\n(опционально);
endif

:Сохранить данные\nпреподавателя;

stop
@enduml